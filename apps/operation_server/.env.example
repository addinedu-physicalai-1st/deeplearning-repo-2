PORT=8000

# AI Service URLs
AI_INTERFACE_URL=http://localhost:8010/inference
LLM_SERVER_URL=http://localhost:8004/feedback

# Database
DATABASE_URL=sqlite:///./focus_monitor.db

# Security
API_KEY=your-secure-api-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_COUNT=30

# Trusted Proxies (comma-separated, empty by default)
TRUSTED_PROXIES=
